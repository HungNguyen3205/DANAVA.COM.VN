{
  "version": 1,
  "functions": {
    "/_middleware": {
      "runtime": "nodejs",
      "matchers": [
        {
          "regexp": "^(?:\\/(_next\\/data\\/[^/]{1,}))?(?:\\/((?!_next\\/|assets\\/|api\\/|admin|favicon|icon|robots|sitemap|.*\\.[a-zA-Z0-9]{2,5}$).*))(\\.json|\\.rsc|\\.segments\\/.+\\.segment\\.rsc)?[\\/#\\?]?$",
          "originalSource": "/((?!_next/|assets/|api/|admin|favicon|icon|robots|sitemap|.*\\.[a-zA-Z0-9]{2,5}$).*)"
        }
      ]
    },
    "/api/admin/media": {},
    "/api/admin/models": {},
    "/api/admin/session": {},
    "/api/anna": {},
    "/api/gym-assistant": {},
    "/api/gym-designs": {},
    "/api/gym-designs/[code]": {},
    "/api/gym-designs/[code]/preview": {},
    "/api/recruit": {},
    "/assets/uploads/[file]": {}
  }
}