SITE_URL=https://danava.com.vn
DANAVA_DATA_DIR=/absolute/persistent/private/danava-data
DANAVA_ADMIN_PASSWORD_HASH=
PORT=3000
# MySQL/MariaDB (production). Bỏ trống DANAVA_DB_HOST để dùng SQLite trong DANAVA_DATA_DIR.
DANAVA_DB_HOST=localhost
DANAVA_DB_PORT=3306
DANAVA_DB_NAME=
DANAVA_DB_USER=
DANAVA_DB_PASSWORD=
# Trợ lý AI ANNA (chỉ phía máy chủ). Không có khóa: ANNA báo chưa sẵn sàng, Báo giá nhanh vẫn chạy.
ANTHROPIC_API_KEY=
# Tùy chọn. Trống = claude-opus-5-5
DANAVA_AI_MODEL=
# Tùy chọn. Trống = 500 câu hỏi/ngày cho cả website
DANAVA_AI_DAILY_LIMIT=
